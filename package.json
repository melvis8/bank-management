{
  "name": "bank-api",
  "version": "1.0.0",
  "description": "RESTful API for Bank Management System",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "build": "cd frontend && npm ci --include=dev && npm run build",
    "postinstall": "cd frontend && npm ci --include=dev && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:report": "NODE_ENV=test vitest run --reporter=json --outputFile=test-results.json --coverage && node scripts/generateReport.js",
    "seed": "node seed.js",
    "seed:rich": "node mock-data.js seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "node-fetch": "^2.7.0",
    "pg": "^8.22.0",
    "rate-limit-redis": "^4.3.1",
    "redis": "^5.12.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.8",
    "nodemon": "^3.1.14",
    "vitest": "^4.1.8"
  }
}
