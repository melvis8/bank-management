# ─── Server Configuration ─────────────────────────────────────
PORT=3000
NODE_ENV=development

# Public URL of this service — used in CamerPay callback URLs and Swagger docs.
# In production: your Render service URL (no trailing slash).
API_BASE_URL=http://localhost:3000

# URL the customer's browser is redirected to after a CamerPay payment completes.
# For unified deploy (backend serves frontend): same as API_BASE_URL.
# For separate frontend: your frontend domain.
FRONTEND_URL=http://localhost:5173

# ─── PostgreSQL / Neon Database ───────────────────────────────
# Copy this from your Neon dashboard → Connection Details → Connection string
# Format: postgresql://username:password@host/dbname?sslmode=require
DATABASE_URL=postgresql://username:password@host/dbname?sslmode=require

# ─── JWT ──────────────────────────────────────────────────────
# Required. Generate a strong random secret: openssl rand -hex 32
# The server refuses to start without this set (except in NODE_ENV=test).
JWT_SECRET=replace_with_a_long_random_secret

# ─── CORS ─────────────────────────────────────────────────────
# For a unified deploy (frontend + backend on the same origin): * is fine.
# For separate deploys: set to your frontend domain.
# Supports comma-separated list: https://app.example.com,https://app2.example.com
CORS_ORIGIN=*

# ─── CamerPay Payment Gateway ────────────────────────────────
# Base URL for the CamerPay API (no trailing slash)
CAMERPAY_BASE_URL=https://camerpay.biz/api
# Bearer token from your CamerPay dashboard (New token button)
CAMERPAY_TOKEN=your_camerpay_api_token_here
# HMAC secret for webhook signature verification (Generate button in CamerPay dashboard)
CAMERPAY_WEBHOOK_SECRET=your_webhook_hmac_secret_here

# ─── Redis (Optional) ─────────────────────────────────────────
# If absent, rate limiting runs in-memory (fine for development and small scale).
# For production: use a Redis provider (Render Redis add-on, Upstash, etc.)
# REDIS_URL=redis://localhost:6379
